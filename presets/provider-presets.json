{
  "kind": "aicommit-provider-presets",
  "schemaVersion": 2,
  "version": "2.1.0",
  "compatibility": {
    "coreMinimum": "1.5.1",
    "coreMaximumExclusive": "3.0.0",
    "adapterContract": 1
  },
  "providers": [
    {
      "id": "openai",
      "label": "OpenAI",
      "adapter": "openai",
      "apiUrl": "https://api.openai.com/v1/chat/completions",
      "defaultModel": "gpt-4o",
      "models": {
        "gpt-4o": {
          "label": "GPT-4o",
          "modelId": "gpt-4o"
        },
        "gpt-5.6-sol": {
          "label": "GPT-5.6 Sol",
          "modelId": "gpt-5.6-sol"
        },
        "gpt-5.6-terra": {
          "label": "GPT-5.6 Terra",
          "modelId": "gpt-5.6-terra"
        },
        "gpt-5.6-luna": {
          "label": "GPT-5.6 Luna",
          "modelId": "gpt-5.6-luna"
        }
      }
    },
    {
      "id": "deepseek",
      "label": "DeepSeek",
      "adapter": "deepseek",
      "apiUrl": "https://api.deepseek.com/v1/chat/completions",
      "defaultModel": "chat",
      "models": {
        "chat": {
          "label": "DeepSeek Chat",
          "modelId": "deepseek-v4-flash"
        },
        "pro": {
          "label": "DeepSeek V4 Pro",
          "modelId": "deepseek-v4-pro"
        }
      }
    },
    {
      "id": "openrouter",
      "label": "OpenRouter",
      "adapter": "openrouter",
      "apiUrl": "https://openrouter.ai/api/v1/chat/completions",
      "defaultModel": "default",
      "models": {
        "default": {
          "modelId": "openai/gpt-4o-mini"
        },
        "auto": {
          "label": "OpenRouter Auto",
          "modelId": "openrouter/auto"
        },
        "gpt-5.6-terra": {
          "label": "GPT-5.6 Terra",
          "modelId": "openai/gpt-5.6-terra"
        },
        "claude-sonnet-5": {
          "label": "Claude Sonnet 5",
          "modelId": "anthropic/claude-sonnet-5"
        },
        "gemini-3.7-flash": {
          "label": "Gemini 3.7 Flash",
          "modelId": "google/gemini-3.7-flash"
        },
        "deepseek-v4-pro": {
          "label": "DeepSeek V4 Pro",
          "modelId": "deepseek/deepseek-v4-pro"
        },
        "qwen3.8-max": {
          "label": "Qwen3.8 Max",
          "modelId": "qwen/qwen3.8-max"
        },
        "glm-5.3": {
          "label": "GLM-5.3",
          "modelId": "z-ai/glm-5.3"
        },
        "kimi-k3": {
          "label": "Kimi K3",
          "modelId": "moonshotai/kimi-k3"
        },
        "grok-4.6": {
          "label": "Grok 4.6",
          "modelId": "x-ai/grok-4.6"
        }
      }
    },
    {
      "id": "minimax",
      "label": "MiniMax",
      "adapter": "minimax",
      "apiUrl": "https://api.minimaxi.com/v1/chat/completions",
      "defaultModel": "default",
      "models": {
        "default": {
          "modelId": "MiniMax-M3",
          "extraBody": {
            "thinking": {
              "type": "disabled"
            },
            "reasoning_split": true
          }
        }
      }
    },
    {
      "id": "kimi-code",
      "label": "Kimi Code",
      "adapter": "custom",
      "apiUrl": "https://api.kimi.com/coding/v1/chat/completions",
      "defaultModel": "default",
      "models": {
        "default": {
          "modelId": "kimi-for-coding"
        }
      }
    },
    {
      "id": "ollama",
      "label": "Ollama (local)",
      "adapter": "ollama",
      "apiUrl": "http://127.0.0.1:11434/api/chat",
      "defaultModel": "qwen",
      "models": {
        "qwen": {
          "label": "Qwen 3 8B",
          "modelId": "qwen3:8b"
        },
        "deepseek": {
          "label": "DeepSeek R1 8B",
          "modelId": "deepseek-r1:8b"
        },
        "gpt-oss": {
          "label": "GPT-OSS 20B",
          "modelId": "gpt-oss:20b"
        }
      }
    }
  ]
}
