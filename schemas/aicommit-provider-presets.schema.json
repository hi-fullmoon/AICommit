{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hi-fullmoon/AICommit/schemas/aicommit-provider-presets.schema.json",
  "title": "AICommit provider preset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "version", "compatibility", "providers"],
  "properties": {
    "kind": { "const": "aicommit-provider-presets" },
    "schemaVersion": { "const": 1 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coreMinimum", "coreMaximumExclusive", "adapterContract"],
      "properties": {
        "coreMinimum": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "coreMaximumExclusive": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "adapterContract": { "const": 1 }
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "adapter", "apiUrl", "modelId"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "not": { "pattern": "^[Cc][Uu][Ss][Tt][Oo][Mm]$" }
          },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "adapter": {
            "enum": ["openai", "openrouter", "deepseek", "minimax", "ollama", "custom"]
          },
          "apiUrl": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "modelId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "extraBody": { "type": "object" }
        }
      }
    }
  }
}
