{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hi-fullmoon/AICommit/schemas/aicommit-team-policy.schema.json",
  "title": "AICommit team policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "language", "commitPolicy"],
  "properties": {
    "kind": { "const": "aicommit-team-policy" },
    "version": { "const": 1 },
    "language": { "enum": ["zh", "en"] },
    "commitPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "types", "scope", "subject", "body", "breakingChange", "language"],
      "properties": {
        "version": { "const": 1 },
        "types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "values"],
          "properties": {
            "mode": { "enum": ["optional", "required", "forbidden"] },
            "values": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 64 }
            }
          }
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxLength"],
          "properties": { "maxLength": { "type": "integer", "minimum": 1, "maximum": 200 } }
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "maxLines"],
          "properties": {
            "mode": { "enum": ["optional", "required", "forbidden"] },
            "maxLines": { "type": "integer", "minimum": 0, "maximum": 50 }
          }
        },
        "breakingChange": { "enum": ["allow", "require", "forbid"] },
        "language": { "enum": ["inherit", "zh", "en"] }
      }
    }
  }
}
