{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hi-fullmoon/AICommit/schemas/aicommit-extension.schema.json",
  "title": "AICommit extension manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "apiVersion", "id", "version", "entry", "capabilities", "permissions"],
  "properties": {
    "kind": { "const": "aicommit-extension" },
    "apiVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "entry": { "type": "string", "pattern": "^[^/].*\\.mjs$" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["contextProvider", "messageValidator", "providerAdapter"] }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credentials"],
      "properties": { "credentials": { "const": false } }
    }
  }
}
