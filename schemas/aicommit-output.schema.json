{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hi-fullmoon/AICommit/schemas/aicommit-output.schema.json",
  "title": "aicommit machine output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ok",
    "message",
    "plan",
    "provider",
    "model",
    "latencyMs",
    "usage",
    "warnings",
    "exitReason",
    "committed",
    "commitState",
    "commitSha",
    "planFile",
    "scope",
    "changeCount",
    "error"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "ok": {
      "type": "boolean"
    },
    "message": {
      "type": ["string", "null"]
    },
    "plan": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message", "files"],
        "properties": {
          "message": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hunks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "ids"],
              "properties": {
                "path": {
                  "type": "string"
                },
                "ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "provider": {
      "type": ["string", "null"]
    },
    "model": {
      "type": ["string", "null"]
    },
    "latencyMs": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "inputTokens": {
          "type": "number",
          "minimum": 0
        },
        "outputTokens": {
          "type": "number",
          "minimum": 0
        },
        "totalTokens": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exitReason": {
      "type": "string",
      "minLength": 1
    },
    "committed": {
      "type": "boolean"
    },
    "commitState": {
      "enum": ["none", "partial", "complete", "unknown"]
    },
    "commitSha": {
      "type": ["string", "null"]
    },
    "planFile": {
      "type": ["string", "null"]
    },
    "scope": {
      "type": ["string", "null"]
    },
    "changeCount": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["category", "code", "message", "retryable", "nextAction"],
      "properties": {
        "category": {
          "enum": [
            "config",
            "git_state",
            "network",
            "provider",
            "response_format",
            "sensitive_data",
            "concurrent_modification",
            "internal"
          ]
        },
        "message": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "nextAction": {
          "type": ["string", "null"]
        }
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "analysis": {
          "type": "object",
          "description": "Large-change coverage and shared request budget; never contains diff or intermediate summaries.",
          "properties": {
            "totalFiles": {
              "type": "number",
              "minimum": 0
            },
            "analyzedFiles": {
              "type": "number",
              "minimum": 0
            },
            "sampledFiles": {
              "type": "number",
              "minimum": 0,
              "description": "Files represented by partial excerpts; not fully analyzed files."
            },
            "strategy": {
              "enum": ["auto", "deep", "fallback"]
            },
            "metadataOnlyFiles": {
              "type": "number",
              "minimum": 0
            },
            "failedFiles": {
              "type": "number",
              "minimum": 0
            },
            "completedChunks": {
              "type": "number",
              "minimum": 0
            },
            "planningCandidatesOriginal": {
              "type": "number",
              "minimum": 0,
              "description": "Local candidates before token-saving planning compaction."
            },
            "planningCandidates": {
              "type": "number",
              "minimum": 0,
              "description": "Candidate bundles sent through hierarchical split planning."
            },
            "requests": {
              "type": "number",
              "minimum": 0
            },
            "budgetedTokens": {
              "type": "number",
              "minimum": 0
            },
            "maxTotalTokens": {
              "type": "number",
              "minimum": 0
            },
            "elapsedMs": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "split": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": { "enum": ["idle", "pending"] },
            "transactionId": { "type": "string" },
            "checkpointPath": { "type": "string" },
            "scope": { "enum": ["staged", "all"] },
            "totalGroups": { "type": "integer", "minimum": 0 },
            "completedGroups": { "type": "integer", "minimum": 0 },
            "pendingGroups": { "type": "integer", "minimum": 0 },
            "completedCommits": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" }
            },
            "inFlight": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "group": { "type": "integer", "minimum": 1 },
                "state": { "enum": ["pending", "committed", "unknown"] }
              }
            },
            "nextAction": { "type": "string" }
          }
        }
      }
    }
  }
}
