{
  "name": "OpenRouter reasoning details",
  "config": {
    "apiUrl": "https://openrouter.ai/api/v1/chat/completions",
    "modelId": "openai/gpt-5.4"
  },
  "request": {
    "messages": [{ "role": "user", "content": "commit" }],
    "temperature": 0.3,
    "maxTokens": 1024,
    "reasoning": { "mode": "on", "effort": "medium" },
    "streaming": false
  },
  "expectedRequest": {
    "stream": true,
    "model": "openai/gpt-5.4",
    "messages": [{ "role": "user", "content": "commit" }],
    "temperature": 0.3,
    "max_tokens": 1024,
    "reasoning": { "effort": "medium" }
  },
  "response": {
    "model": "openai/gpt-5.4",
    "choices": [
      {
        "message": {
          "content": "fix: retry transient provider errors",
          "reasoning_details": [{ "type": "thinking", "text": "classified the failure" }]
        },
        "finish_reason": "stop"
      }
    ],
    "usage": { "input_tokens": 32, "output_tokens": 9 }
  },
  "expectedResponse": {
    "provider": "openrouter",
    "model": "openai/gpt-5.4",
    "content": "fix: retry transient provider errors",
    "reasoning": "classified the failure",
    "usage": { "inputTokens": 32, "outputTokens": 9, "totalTokens": 41 },
    "finishReason": "stop"
  },
  "expectedCapabilities": {
    "streaming": true,
    "reasoning": "native",
    "tokenBudget": "max_tokens",
    "usage": true,
    "finishReason": true
  },
  "expectedHeaders": { "X-Title": "aicommit" }
}
