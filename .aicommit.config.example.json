{
  "schemaVersion": 1,
  "defaultProvider": "minimax",
  "providers": {
    "minimax": {
      "providerType": "minimax",
      "apiUrl": "https://api.minimaxi.com/v1/chat/completions",
      "apiKeyEnv": "MINIMAX_API_KEY",
      "defaultModel": "default",
      "models": {
        "default": {
          "modelId": "MiniMax-M3",
          "extraBody": {
            "thinking": {
              "type": "disabled"
            },
            "reasoning_split": true
          }
        }
      }
    },
    "deepseek": {
      "providerType": "deepseek",
      "apiUrl": "https://api.deepseek.com/v1/chat/completions",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "defaultModel": "chat",
      "models": {
        "chat": { "modelId": "deepseek-v4-flash" }
      }
    },
    "openrouter": {
      "providerType": "openrouter",
      "apiUrl": "https://openrouter.ai/api/v1/chat/completions",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "defaultModel": "fast",
      "models": {
        "fast": { "modelId": "openai/gpt-4o-mini" },
        "quality": { "modelId": "openai/gpt-4o" }
      }
    },
    "kimi-code": {
      "providerType": "custom",
      "apiUrl": "https://api.kimi.com/coding/v1/chat/completions",
      "apiKeyEnv": "KIMI_API_KEY",
      "defaultModel": "default",
      "models": {
        "default": { "modelId": "kimi-for-coding" }
      }
    },
    "ollama": {
      "providerType": "ollama",
      "apiUrl": "http://127.0.0.1:11434/api/chat",
      "defaultModel": "qwen",
      "models": {
        "qwen": { "modelId": "qwen3:8b" },
        "deepseek": { "modelId": "deepseek-r1:14b" }
      }
    }
  },
  "language": "en",
  "commitPolicy": {
    "version": 1,
    "types": ["feat", "fix", "chore", "docs", "refactor", "test", "style", "perf", "ci", "build"],
    "scope": {
      "mode": "optional",
      "values": []
    },
    "subject": {
      "maxLength": 72
    },
    "body": {
      "mode": "optional",
      "maxLines": 8
    },
    "breakingChange": "allow",
    "language": "inherit"
  },
  "allowProjectPrompt": false,
  "prompt": "",
  "repositoryContext": {
    "enabled": true,
    "maxChars": 4000,
    "recentCommits": {
      "enabled": true,
      "count": 12,
      "maxChars": 1000
    },
    "packageBoundaries": {
      "enabled": true,
      "maxEntries": 40,
      "maxChars": 800
    },
    "conventions": {
      "enabled": true,
      "trustedFiles": [],
      "maxFiles": 4,
      "maxChars": 1400
    },
    "commitlint": {
      "enabled": true,
      "maxChars": 800
    }
  },
  "maxTokens": 1024,
  "timeoutMs": 120000,
  "retry": {
    "maxAttempts": 3,
    "baseDelayMs": 500,
    "maxDelayMs": 5000
  },
  "credentialHelper": {
    "enabled": false,
    "username": "aicommit"
  },
  "maxDiffChars": 30000,
  "maxFileDiffChars": 3000,
  "splitMaxDiffChars": 16000,
  "splitMaxPlanFiles": 100,
  "diffContextLines": 1,
  "regenerateWithDiff": false,
  "reasoning": {
    "mode": "on",
    "effort": "medium",
    "maxTokens": 4096,
    "maxDisplayChars": 12000
  },
  "stripFiles": ["*.min.js", "*.map", "*.snap"]
}
