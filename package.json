{
  "name": "@hifullmoon/aicommit",
  "version": "2.1.0",
  "description": "Safe, local-first AI commit message generator for Git workflows",
  "type": "module",
  "bin": {
    "aicommit": "./bin/aicommit.js"
  },
  "files": [
    ".aicommit.config.example.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "bin/",
    "docs/*.md",
    "docs/examples/",
    "presets/",
    "schemas/",
    "templates/",
    "src/"
  ],
  "scripts": {
    "start": "node bin/aicommit.js",
    "test": "node --test --test-concurrency=1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "c8 node --test --test-concurrency=1",
    "eval": "node eval/run.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "docs:terminal-demo": "node scripts/readme-terminal-demo.mjs",
    "release:version": "node scripts/update-version.mjs",
    "release:npm:check": "node scripts/verify-release.mjs && npm run ci && npm run test:package && npm pack --dry-run",
    "ci": "npm run lint && npm run format:check && npm run eval && npm run coverage"
  },
  "c8": {
    "all": true,
    "include": [
      "src/**/*.js",
      "bin/**/*.js"
    ],
    "reporter": [
      "text",
      "lcov"
    ],
    "check-coverage": true,
    "lines": 70
  },
  "dependencies": {
    "@inquirer/checkbox": "^4.3.2",
    "@inquirer/confirm": "^5.1.0",
    "@inquirer/core": "^10.3.2",
    "@inquirer/editor": "^4.1.0",
    "@inquirer/input": "^4.3.1",
    "@inquirer/password": "^4.0.23",
    "@inquirer/select": "^4.1.0",
    "boxen": "^8.0.1",
    "chalk": "^5.4.0",
    "ora": "^8.2.0",
    "wrap-ansi": "^9.0.2"
  },
  "keywords": [
    "git",
    "commit",
    "ai",
    "cli",
    "conventional-commits",
    "openai",
    "deepseek",
    "openrouter",
    "ollama"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hi-fullmoon/AICommit.git"
  },
  "bugs": {
    "url": "https://github.com/hi-fullmoon/AICommit/issues"
  },
  "homepage": "https://github.com/hi-fullmoon/AICommit#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "c8": {
      "test-exclude": "7.0.1"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "c8": "10.1.3",
    "eslint": "9.39.5",
    "prettier": "3.9.6"
  }
}
